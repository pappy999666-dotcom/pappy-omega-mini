{
  "name": "pappy-omega-mini",
  "version": "0.1.0",
  "private": true,
  "description": "PAPPY OMEGA MINI — multi-tenant Telegram + WhatsApp SaaS bot",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check package.json tsconfig.json src tests README.md",
    "doctor": "tsx src/doctor.ts",
    "doctor:ci": "tsx src/doctor.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@crysnovax/baileys": "^2.7.12",
    "bullmq": "^5.58.0",
    "dotenv": "^17.2.1",
    "ioredis": "^5.7.0",
    "link-preview-js": "^3.2.0",
    "mongoose": "^8.18.0",
    "pino": "^9.9.0",
    "sharp": "0.35.3",
    "telegraf": "^4.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "terser": "^5.50.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
