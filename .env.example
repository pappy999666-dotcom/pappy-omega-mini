# Telegram
TELEGRAM_BOT_TOKEN=

# Global owner Telegram ID(s), comma-separated
OWNER_TELEGRAM_IDS=

# Required in production; use a random secret of at least 32 characters
ENCRYPTION_SECRET=

# Optional deployment integrations
OPTIONAL_DOMAIN=
TELEGRAM_WEBHOOK_URL=
OBJECT_STORAGE_BUCKET=

# Optional durable storage
MONGODB_URI=mongodb://127.0.0.1:27017/pappy_omega_mini
REDIS_URL=redis://127.0.0.1:6379

# Runtime
NODE_ENV=development
APP_TIMEZONE=Africa/Lagos
SESSION_ROOT=./storage/sessions
MEDIA_ROOT=./data/media

# Limits
MAX_MEDIA_BYTES=52428800
# `.play`/`.video` downloader; install yt-dlp and ffmpeg/ffprobe on the runtime host
YT_DLP_BIN=yt-dlp
FFPROBE_BIN=ffprobe
PLAY_MAX_FILESIZE=50M
PLAY_MAX_BYTES=52428800
QUEUE_CONCURRENCY=4
# Authenticated WhatsApp startup recovery window; valid range: 30000-300000 ms
WHATSAPP_READY_TIMEOUT_MS=90000

# External panel workload control; keep disabled until a TLS reverse proxy/domain is configured
WORKLOAD_CONTROL_ENABLED=false
WORKLOAD_CONTROL_URL=
WORKLOAD_CONTROL_BIND=127.0.0.1
WORKLOAD_CONTROL_PORT=8787
WORKLOAD_PACKAGE_VERSION=1.2.92
WORKLOAD_MIN_WORKER_VERSION=1.0.0
WORKLOAD_HEARTBEAT_TIMEOUT_MS=75000

# Never commit a real .env file.

# --- Baileys engine tuning (audit 2026-09-06) ---
# Bounded retry budget for transient Baileys send/decrypt failures.
# 0 disables retries (silent drops on transient failures).
BAILEYS_MAX_MSG_RETRY_COUNT=1
BAILEYS_RETRY_REQUEST_DELAY_MS=250
# Fire initial contacts/chats queries on socket open (adds reconnect cost;
# the app resolves inventories on demand). true/false
BAILEYS_FIRE_INIT_QUERIES=false
# Engine high-quality link preview generation. The app supplies its own
# cached native previews, so engine-side generation is duplicate work.
BAILEYS_HIGH_QUALITY_LINK_PREVIEW=false
# Skip newsletter/broadcast-list JIDs before processing.
BAILEYS_IGNORE_EXTRA_JIDS=true
# History sync kept on reconnect: nonblocking (smallest) | standard.
BAILEYS_HISTORY_MODE=nonblocking
